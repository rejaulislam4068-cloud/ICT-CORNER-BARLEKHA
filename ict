<style>
    body {margin:0;font-family:Arial, sans-serif;line-height:1.6;background:#f7f7f7;}
    
    /* Header with logo and name */
    header {display:flex; align-items:center; padding:10px 40px; background:#002147; color:#fff;}
    header img {height:60px; margin-right:15px;}
    header h1 {margin:0; font-size:24px;}
    
    /* Navigation section */
    nav {background:#004080; padding:10px 40px;}
    nav a {color:#fff;margin-right:20px;text-decoration:none;font-size:16px; font-weight:bold;}
    nav a:hover {color:#ffcc00;}
    
    /* Hero section */
    .hero {background:#000;color:white;padding:100px 40px;text-align:center;}
    .hero h1 {font-size:48px;margin:0;}
    .hero p {font-size:20px;margin-top:10px;}
    .btn {display:inline-block;padding:12px 25px;margin-top:20px;background:#ffcc00;color:#000;
        text-decoration:none;border-radius:5px;font-weight:bold;}
    
    /* General sections */
    .section {padding:60px 40px;background:white;margin:20px auto;max-width:1200px;border-radius:8px;}
    h2, h3 {text-align:center;color:#003366;}
    h2 {margin-bottom:30px;}
    h3 {margin-bottom:20px;}
    .grid {display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:20px;}
    .card {background:#fff;padding:20px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);}
    footer {background:#002147;color:#fff;text-align:center;padding:25px;margin-top:40px;}
    ul {list-style-type:none;padding-left:0;}
    ul li {padding:8px 0;}
    
    /* Principal message */
    .principal-message {text-align:center; padding:30px 20px;}
    .principal-message img {width:150px; border-radius:50%; margin-bottom:15px;}
    
    /* Teacher section black background */
    .teachers-section {background:#000;color:#fff;border-radius:8px;padding:60px 40px;}
    .teacher-card {text-align:center; background:#1a1a1a; color:#fff; position:relative; overflow:hidden; border-radius:8px; padding:20px;}
    .teacher-card img {width:100%; border-radius:50%; margin-bottom:15px; transition: transform 0.3s;}
    .teacher-card:hover img {transform: scale(1.1);}
    .overlay {position:absolute; bottom:0; background:rgba(0,0,0,0.85); color:#fff; width:100%; text-align:center; padding:15px; opacity:0; transition: opacity 0.3s; border-radius:0 0 8px 8px;}
    .teacher-card:hover .overlay {opacity:1;}
</style>
</head>

